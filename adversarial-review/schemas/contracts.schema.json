{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:scriptdom:adversarial-review:contracts:1.0",
  "$defs": {
    "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "text": { "type": "string", "minLength": 1, "maxLength": 8000 },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "id", "headSha", "source", "category", "severity", "confidence", "title", "description", "evidence", "recommendation", "disposition"],
      "properties": {
        "schemaVersion": { "const": "1.0" },
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,128}$" },
        "headSha": { "$ref": "#/$defs/sha" },
        "source": { "enum": ["build", "test", "semgrep", "roslyn", "reviewer", "orchestrator"] },
        "category": { "$ref": "#/$defs/text" },
        "severity": { "enum": ["critical", "high", "medium", "low", "info"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "title": { "type": "string", "minLength": 1, "maxLength": 256 },
        "description": { "$ref": "#/$defs/text" },
        "evidence": {
          "type": "array", "minItems": 1, "maxItems": 20,
          "items": { "$ref": "#/$defs/evidence" }
        },
        "recommendation": { "$ref": "#/$defs/text" },
        "disposition": { "enum": ["unreviewed", "confirmed", "false-positive", "accepted-risk", "duplicate"] }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reference", "detail", "startLine", "endLine"],
      "properties": {
        "kind": { "enum": ["file", "check", "artifact"] },
        "reference": { "type": "string", "minLength": 1, "maxLength": 512 },
        "detail": { "$ref": "#/$defs/text" },
        "startLine": { "type": ["integer", "null"], "minimum": 1 },
        "endLine": { "type": ["integer", "null"], "minimum": 1 }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "headSha", "name", "platform", "conclusion", "artifact"],
      "properties": {
        "schemaVersion": { "const": "1.0" },
        "headSha": { "$ref": "#/$defs/sha" },
        "name": { "enum": ["build", "test", "semgrep", "roslyn"] },
        "platform": { "enum": ["windows", "ubuntu", "independent"] },
        "conclusion": { "enum": ["passed", "failed", "cancelled", "missing"] },
        "artifact": { "type": "string", "minLength": 1, "maxLength": 512 }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "repository", "pullRequest", "headSha", "baseSha", "configurationSha", "workflowRunId", "runAttempt", "authorizationId", "authorizedActor"],
      "properties": {
        "schemaVersion": { "const": "1.0" },
        "repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
        "pullRequest": { "type": "integer", "minimum": 1 },
        "headSha": { "$ref": "#/$defs/sha" },
        "baseSha": { "$ref": "#/$defs/sha" },
        "configurationSha": { "$ref": "#/$defs/sha" },
        "workflowRunId": { "type": "integer", "minimum": 1 },
        "runAttempt": { "type": "integer", "minimum": 1 },
        "authorizationId": { "$ref": "#/$defs/text" },
        "authorizedActor": { "type": "string", "pattern": "^[A-Za-z0-9-]{1,39}$" }
      }
    },
    "round": {
      "type": "object", "additionalProperties": false,
      "required": ["number", "provider", "model", "selectionReason", "promptVersion", "inputTokens", "outputTokens", "latencyMilliseconds", "estimatedCostUsd", "outcome"],
      "properties": {
        "number": { "type": "integer", "minimum": 1 },
        "provider": { "$ref": "#/$defs/text" },
        "model": { "$ref": "#/$defs/text" },
        "selectionReason": { "$ref": "#/$defs/text" },
        "promptVersion": { "$ref": "#/$defs/text" },
        "inputTokens": { "type": ["integer", "null"], "minimum": 0 },
        "outputTokens": { "type": ["integer", "null"], "minimum": 0 },
        "latencyMilliseconds": { "type": "integer", "minimum": 0 },
        "estimatedCostUsd": { "type": ["number", "null"], "minimum": 0 },
        "outcome": { "enum": ["completed", "failed", "malformed", "cancelled", "budget-exceeded"] }
      },
      "allOf": [
        {
          "if": { "properties": { "outcome": { "const": "budget-exceeded" } }, "required": ["outcome"] },
          "then": {
            "properties": {
              "inputTokens": { "type": "integer", "minimum": 0 },
              "outputTokens": { "type": "integer", "minimum": 0 },
              "estimatedCostUsd": { "type": "number", "minimum": 0 }
            }
          }
        }
      ]
    },
    "audit": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "mode", "calibration", "run", "checks", "findings", "rounds", "expectedRounds", "status", "riskScore", "blockers", "limitations"],
      "properties": {
        "schemaVersion": { "const": "1.0" },
        "mode": { "const": "report-only" },
        "calibration": { "const": "uncalibrated" },
        "run": { "$ref": "#/$defs/run" },
        "checks": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/check" } },
        "findings": { "type": "array", "maxItems": 500, "items": { "$ref": "#/$defs/finding" } },
        "rounds": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/round" } },
        "expectedRounds": { "type": "integer", "minimum": 1, "maximum": 100 },
        "status": { "enum": ["complete", "incomplete", "stale"] },
        "riskScore": { "type": "null" },
        "blockers": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/text" } },
        "limitations": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/text" } },
        "risk": { "$ref": "#/$defs/risk" }
      }
    },
    "level": { "enum": ["low", "mid", "high"] },
    "risk": {
      "type": "object", "additionalProperties": false,
      "required": ["rubricVersion", "signals", "factors", "assessment", "decision", "missing", "label", "labelOutcome", "autoMergeOutcome"],
      "properties": {
        "rubricVersion": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,64}$" },
        "signals": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object", "additionalProperties": false,
              "required": ["addedCodeLines", "deletedCodeLines", "coveredAddedLines", "instrumentableAddedLines", "lowFindings", "mediumFindings", "newStaticWarnings", "hasIntegrationTests", "hasUnresolvedHighOrCriticalFinding"],
              "properties": {
                "addedCodeLines": { "type": "integer", "minimum": 0 },
                "deletedCodeLines": { "type": "integer", "minimum": 0 },
                "coveredAddedLines": { "type": ["integer", "null"], "minimum": 0 },
                "instrumentableAddedLines": { "type": ["integer", "null"], "minimum": 0 },
                "lowFindings": { "type": "integer", "minimum": 0 },
                "mediumFindings": { "type": "integer", "minimum": 0 },
                "newStaticWarnings": { "type": "integer", "minimum": 0 },
                "hasIntegrationTests": { "type": ["boolean", "null"] },
                "hasUnresolvedHighOrCriticalFinding": { "type": "boolean" }
              }
            }
          ]
        },
        "factors": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object", "additionalProperties": false,
              "required": ["rubricVersion", "changedLines", "coverage", "adversarialFindings", "staticWarnings", "hasIntegrationTests", "hasUnresolvedHighOrCriticalFinding"],
              "properties": {
                "rubricVersion": { "type": "string" },
                "changedLines": { "$ref": "#/$defs/level" },
                "coverage": { "enum": ["low", "mid", "high", "not-applicable"] },
                "adversarialFindings": { "$ref": "#/$defs/level" },
                "staticWarnings": { "$ref": "#/$defs/level" },
                "hasIntegrationTests": { "type": ["boolean", "null"] },
                "hasUnresolvedHighOrCriticalFinding": { "type": "boolean" }
              }
            }
          ]
        },
        "assessment": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object", "additionalProperties": false,
              "required": ["schemaVersion", "status", "rubricVersion", "requestedModel", "answeredModel", "classification", "confidence", "probabilities", "inputTokens", "outputTokens", "reason"],
              "properties": {
                "schemaVersion": { "const": "1.0" },
                "status": { "enum": ["assessed", "unavailable", "invalid"] },
                "rubricVersion": { "type": "string" },
                "requestedModel": { "type": "string", "maxLength": 64 },
                "answeredModel": { "type": ["string", "null"], "maxLength": 64 },
                "classification": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/level" }] },
                "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
                "probabilities": {
                  "oneOf": [
                    { "type": "null" },
                    { "type": "object", "additionalProperties": false, "properties": { "low": { "type": "number" }, "mid": { "type": "number" }, "high": { "type": "number" } } }
                  ]
                },
                "inputTokens": { "type": ["integer", "null"], "minimum": 0 },
                "outputTokens": { "type": ["integer", "null"], "minimum": 0 },
                "reason": { "type": ["string", "null"], "maxLength": 512 }
              }
            }
          ]
        },
        "decision": {
          "type": "object", "additionalProperties": false,
          "required": ["eligibleForLowRiskLabel", "reasons"],
          "properties": {
            "eligibleForLowRiskLabel": { "type": "boolean" },
            "reasons": { "type": "array", "maxItems": 20, "items": { "$ref": "#/$defs/text" } }
          }
        },
        "missing": { "type": "array", "maxItems": 20, "items": { "$ref": "#/$defs/text" } },
        "label": { "type": ["string", "null"], "maxLength": 50 },
        "labelOutcome": { "enum": ["pending", "applied", "failed", "skipped"] },
        "autoMergeOutcome": { "enum": ["pending", "enabled", "failed", "not-eligible", "skipped"] }
      }
    }
  }
}
