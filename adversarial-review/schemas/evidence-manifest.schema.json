{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:scriptdom:adversarial-review:evidence-manifest:1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "identity", "check", "platform", "conclusion", "files"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "identity": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "pullRequest", "headSha", "workflowRunId", "runAttempt"],
      "properties": {
        "repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
        "pullRequest": { "type": "integer", "minimum": 1 },
        "headSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "workflowRunId": { "type": "integer", "minimum": 1 },
        "runAttempt": { "type": "integer", "minimum": 1 }
      }
    },
    "check": { "enum": ["build", "test", "semgrep", "roslyn", "foundation", "static-analysis", "preparation"] },
    "platform": { "enum": ["windows", "ubuntu", "independent"] },
    "conclusion": { "enum": ["passed", "failed", "cancelled", "missing"] },
    "files": {
      "type": "array", "minItems": 1, "maxItems": 1000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "bytes", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1, "maxLength": 512 },
          "bytes": { "type": "integer", "minimum": 0, "maximum": 20971520 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  }
}
