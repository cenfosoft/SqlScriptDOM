{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:scriptdom:adversarial-review:configuration:1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "enabled", "authorizationLabel", "authorizedActors", "environment", "rounds", "limits", "models"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "enabled": { "type": "boolean" },
    "authorizationLabel": { "type": "string", "minLength": 1, "maxLength": 50 },
    "authorizedActors": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z0-9-]{1,39}$" } },
    "environment": { "type": "string", "minLength": 1, "maxLength": 255 },
    "rounds": { "type": ["integer", "null"], "minimum": 1, "maximum": 100 },
    "limits": {
      "type": "object", "additionalProperties": false,
      "required": ["maxInputTokens", "maxOutputTokens", "timeoutSeconds", "maxRetries", "perAuthorizationUsd", "monthlyUsd"],
      "properties": {
        "maxInputTokens": { "type": ["integer", "null"], "minimum": 1 },
        "maxOutputTokens": { "type": ["integer", "null"], "minimum": 1 },
        "timeoutSeconds": { "type": ["integer", "null"], "minimum": 1 },
        "maxRetries": { "type": ["integer", "null"], "minimum": 0, "maximum": 10 },
        "perAuthorizationUsd": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "monthlyUsd": { "type": ["number", "null"], "exclusiveMinimum": 0 }
      }
    },
    "models": {
      "type": "array", "maxItems": 100,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["provider", "model", "enabled"],
        "properties": {
          "provider": { "enum": ["github-models"] },
          "model": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9/_.:-]{0,199}$" },
          "enabled": { "type": "boolean" }
        }
      }
    }
  }
}
